---
import Default from '@astrojs/starlight/components/PageTitle.astro';

const { godot } = Astro.locals.starlightRoute.entry.data;
---

<Default />
{
	godot && (
		<p class="tutorial-meta">
			<span class="pill">Godot {godot}</span>
		</p>
	)
}

<style>
	.tutorial-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1rem;
	}
	.pill {
		font-size: 1rem;
		padding: 0.25rem 0.75rem;
		border-radius: 45px;
		color: var(--qf-text);
		background: var(--qf-tag);
	}
</style>
