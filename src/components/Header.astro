---
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
---

<div class="qf-header">
	<SiteTitle />
	<nav class="tabs" aria-label="Site">
		<a href="/write/" aria-current={Astro.url.pathname.startsWith('/write') ? 'page' : undefined}>
			<span class="full">Write a page</span><span class="short" aria-hidden="true">Write</span>
		</a>
		<a href="/support/" aria-current={Astro.url.pathname.startsWith('/support') ? 'page' : undefined}>Support</a>
	</nav>
	<div class="theme print:hidden">
		<ThemeSelect />
	</div>
</div>

<style>
	.qf-header {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		height: 100%;
	}
	.tabs {
		display: flex;
		gap: 0.25rem;
		margin-left: auto;
	}
	.tabs .full {
		display: none;
	}
	.tabs a {
		padding: 0.4rem 0.7rem;
		border-radius: 999px;
		color: var(--qf-muted);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}
	.tabs a:hover,
	.tabs a:focus-visible {
		color: var(--qf-text);
		background: var(--qf-surface);
	}
	.tabs a[aria-current='page'] {
		color: var(--qf-text);
		background: var(--qf-surface);
	}
	.theme {
		display: none;
	}
	@media (min-width: 50rem) {
		.tabs a {
			padding: 0.4rem 0.9rem;
		}
		.tabs .full {
			display: inline;
		}
		.tabs .short {
			display: none;
		}
		.theme {
			display: flex;
		}
	}
</style>

<script>
	import { pagefindUserConfig } from 'virtual:starlight/pagefind-config';

	document.addEventListener('astro:after-swap', async () => {
		if (import.meta.env.DEV) return;
		for (const search of document.querySelectorAll<HTMLElement>('site-search')) {
			const mount = search.querySelector('#starlight__search');
			if (!mount || mount.children.length) continue;
			let translations = {};
			try {
				translations = JSON.parse(search.dataset.translations || '{}');
			} catch {}
			const { PagefindUI } = await import('@pagefind/default-ui');
			new PagefindUI({
				...pagefindUserConfig,
				element: mount,
				baseUrl: import.meta.env.BASE_URL,
				bundlePath: import.meta.env.BASE_URL.replace(/\/$/, '') + '/pagefind/',
				showImages: false,
				translations,
				showSubResults: true,
			});
		}
	});
</script>
