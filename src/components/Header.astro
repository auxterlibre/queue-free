---
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const path = Astro.url.pathname;
const isWrite = path.startsWith('/write');
const isSupport = path.startsWith('/support');
const current = (on: boolean) => (on ? 'page' : undefined);
---

<div class="qf-header">
	<SiteTitle />
	<nav class="tabs" aria-label="Site">
		<a href="/" aria-current={current(!isWrite && !isSupport)}>Tutorials</a>
		<a href="/write/" aria-current={current(isWrite)}>
			<span class="full">Write a page</span><span class="short" aria-hidden="true">Write</span>
		</a>
		<a href="/support/" aria-current={current(isSupport)}>Support</a>
	</nav>
	<div class="theme print:hidden">
		<ThemeSelect />
	</div>
</div>

<style>
	.qf-header {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		height: 100%;
	}
	.tabs {
		display: flex;
		gap: 1rem;
		margin-left: auto;
	}
	.tabs .full {
		display: none;
	}
	/* Below 50rem the logo already links home and three tabs overflow. */
	.tabs a:first-child {
		display: none;
	}
	.tabs a {
		padding: 0 0.5rem;
		border-bottom: 2px solid transparent;
		color: var(--qf-muted);
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.5rem;
		text-decoration: none;
		white-space: nowrap;
	}
	.tabs a:hover,
	.tabs a:focus-visible {
		color: var(--qf-link);
	}
	.tabs a[aria-current='page'] {
		color: var(--qf-text);
		border-bottom-color: var(--qf-text);
	}
	.theme {
		display: none;
	}
	/* Below 50rem the logo and tabs don't fit beside Starlight's menu button; the drawer carries the links instead. */
	:global([data-has-sidebar]) .tabs {
		display: none;
	}
	@media (min-width: 50rem) {
		:global([data-has-sidebar]) .tabs {
			display: flex;
		}
		.tabs .full {
			display: inline;
		}
		.tabs a:first-child {
			display: block;
		}
		.tabs .short {
			display: none;
		}
		.theme {
			display: flex;
		}
	}
</style>

<script>
	import { pagefindUserConfig } from 'virtual:starlight/pagefind-config';

	document.addEventListener('astro:after-swap', async () => {
		if (import.meta.env.DEV) return;
		for (const search of document.querySelectorAll<HTMLElement>('site-search')) {
			const mount = search.querySelector('#starlight__search');
			if (!mount || mount.children.length) continue;
			let translations = {};
			try {
				translations = JSON.parse(search.dataset.translations || '{}');
			} catch {}
			const { PagefindUI } = await import('@pagefind/default-ui');
			new PagefindUI({
				...pagefindUserConfig,
				element: mount,
				baseUrl: import.meta.env.BASE_URL,
				bundlePath: import.meta.env.BASE_URL.replace(/\/$/, '') + '/pagefind/',
				showImages: false,
				translations,
				showSubResults: true,
			});
		}
	});
</script>
