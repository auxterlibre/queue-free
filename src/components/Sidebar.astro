---
import Default from '@astrojs/starlight/components/Sidebar.astro';
import Search from 'virtual:starlight/components/Search';
---

{/*
	Persisted across client-side navigations so the search (Pagefind, Cmd+K),
	Starlight's collapse-state script, scroll position and open groups all
	survive a page swap. Only the current-page marker needs refreshing.
*/}
<div class="qf-sidebar" transition:persist="sidebar">
	<Search />
	<Default />
	<nav class="drawer-links" aria-label="Site">
		<a href="/write/">Write a page</a>
		<a href="/support/">Support</a>
	</nav>
</div>

<style>
	/* 32px between the search box and the first group, per the design. */
	div {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}
	.drawer-links {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--qf-line);
	}
	.drawer-links a {
		padding: 0.5rem;
		border-radius: 0.25rem;
		color: var(--qf-text);
		font-weight: 700;
		line-height: 1.5rem;
		text-decoration: none;
	}
	.drawer-links a:hover,
	.drawer-links a:focus-visible {
		color: var(--qf-link);
	}
	@media (min-width: 50rem) {
		.drawer-links {
			display: none;
		}
	}
</style>

<script>
	document.addEventListener('astro:after-swap', () => {
		const path = location.pathname.replace(/\/$/, '');
		for (const a of document.querySelectorAll<HTMLAnchorElement>('.sidebar-content a[href]')) {
			const isCurrent = new URL(a.href).pathname.replace(/\/$/, '') === path;
			if (isCurrent) a.setAttribute('aria-current', 'page');
			else a.removeAttribute('aria-current');
		}
	});
</script>
