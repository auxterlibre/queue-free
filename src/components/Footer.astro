---
import Default from '@astrojs/starlight/components/Footer.astro';
import { KOFI_NAME } from '../site.ts';
---

<Default><slot /></Default>

<script is:inline src="https://storage.ko-fi.com/cdn/scripts/overlay-widget.js"></script>
<script is:inline define:vars={{ KOFI_NAME }}>
	// The ClientRouter swaps the body on navigation, which drops the widget
	// Ko-fi injected, so redraw it on every page load.
	document.addEventListener('astro:page-load', () => {
		if (typeof kofiWidgetOverlay === 'undefined') return;
		if (document.querySelector('.floatingchat-container-wrap')) return;
		kofiWidgetOverlay.draw(KOFI_NAME, {
			'type': 'floating-chat',
			'floating-chat.donateButton.text': 'Support Me',
			'floating-chat.donateButton.background-color': '#5bc0de',
			'floating-chat.donateButton.text-color': '#323842',
		});
	});
</script>
