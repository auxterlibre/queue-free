---
interface SceneNode {
	name: string;
	type: string;
	script: boolean;
	unique: boolean;
	note?: string;
	children: SceneNode[];
}

interface Props {
	tree?: string;
	nodes?: SceneNode[];
}

function parse(text: string): SceneNode[] {
	const lines = text.split('\n').filter((l) => l.trim());
	const baseIndent = Math.min(...lines.map((l) => l.match(/^\s*/)![0].length));
	const roots: SceneNode[] = [];
	const stack: { depth: number; node: SceneNode }[] = [];
	for (const line of lines) {
		const m = line.match(/^(\s*)([^:"\[]+?)\s*(?::\s*(\w+))?\s*((?:\[\w+\]\s*)*)(?:"(.*)")?\s*$/);
		if (!m) throw new Error(`SceneTree: can't read line "${line}"`);
		const depth = (m[1].length - baseIndent) / 2;
		const node = {
			name: m[2],
			type: m[3] ?? 'Node',
			script: m[4].includes('[script]'),
			unique: m[4].includes('[unique]'),
			note: m[5],
			children: [],
		};
		while (stack.length && stack[stack.length - 1].depth >= depth) stack.pop();
		(stack.length ? stack[stack.length - 1].node.children : roots).push(node);
		stack.push({ depth, node });
	}
	return roots;
}

const { tree, nodes = parse(tree ?? '') } = Astro.props;
const icon = (name: string) => `/godot-editor-icons/${name}.svg`;
---

<ul class:list={[{ 'scene-tree': tree !== undefined }]} role={tree !== undefined ? 'tree' : 'group'}>
	{
		nodes.map((n) => (
			<li role="treeitem">
				<span class="row">
					<img src={icon(n.type)} alt="" width="16" height="16" />
					<span class="name">{n.name}</span>
					<span class="type">{n.type}</span>
					{n.unique && <img class="flag" src={icon('SceneUniqueName')} alt="unique name" title="Access as Unique Name (%)" width="16" height="16" />}
					{n.script && <img class="script" src={icon('Script')} alt="has script" title="Has a script" width="16" height="16" />}
					{n.note && <span class="note">{n.note}</span>}
				</span>
				{n.children.length > 0 && <Astro.self nodes={n.children} />}
			</li>
		))
	}
</ul>

<style>
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.scene-tree {
		padding: 1rem;
		border-radius: 0.5rem;
		background: var(--qf-frame-tree);
		font-size: var(--sl-text-sm);
		color: var(--qf-code-default);
		overflow-x: auto;
	}
	.scene-tree {
		--line: 1px solid var(--qf-frame-line);
		--indent: 14px;
	}
	/* Guide sits at the parent icon's centre (8px); children start past the tick. */
	ul ul {
		margin: 0 0 0 8px;
		padding-left: var(--indent);
	}
	li {
		margin: 0;
		position: relative;
	}
	/* Vertical guide runs the full item height, except for the last child... */
	ul ul > li:not(:last-child)::before {
		content: '';
		position: absolute;
		left: calc(-1 * var(--indent));
		top: 0;
		bottom: 0;
		border-left: var(--line);
	}
	.row {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.15rem 0;
		white-space: nowrap;
		position: relative;
	}
	/* ...where it stops at the row's centre, meeting the tick to form a corner. */
	ul ul > li > .row::before {
		content: '';
		position: absolute;
		left: calc(-1 * var(--indent));
		top: 0;
		height: 50%;
		border-left: var(--line);
	}
	ul ul > li > .row::after {
		content: '';
		position: absolute;
		left: calc(-1 * var(--indent));
		top: 50%;
		width: 10px;
		border-top: var(--line);
	}
	.type {
		color: var(--qf-frame-muted);
		font-size: var(--sl-text-xs);
	}
	/* Hover highlight like the Godot scene dock. The box-shadow spread pads the
	   highlight without changing the row box that the guide lines anchor to. */
	@media (hover: hover) {
		.row {
			--hl: color-mix(in srgb, var(--qf-code-default) 10%, transparent);
			border-radius: 0.125rem;
		}
		.row:hover {
			background: var(--hl);
			box-shadow: 0 0 0 0.25rem var(--hl);
		}
		.row:hover .note {
			filter: brightness(1.2) saturate(1.2);
		}
		:global(:root[data-theme='light']) .row:hover .note {
			filter: brightness(0.8) saturate(1.2);
		}
		@media (prefers-reduced-motion: no-preference) {
			.row,
			.note {
				transition: background-color 0.12s ease, box-shadow 0.12s ease, filter 0.12s ease;
			}
		}
	}
	.flag,
	.script {
		margin-left: 0.25rem;
	}
	.note {
		position: relative;
		margin-left: 1rem;
		padding: 0.125rem 0.75rem;
		border-radius: 0.375rem;
		background: var(--qf-frame-note);
		color: #1a1a1a;
		font-style: italic;
	}
	.note::before {
		content: '';
		position: absolute;
		top: 50%;
		right: 100%;
		border: 0.375rem solid transparent;
		border-right-color: var(--qf-frame-note);
		border-left: 0;
		transform: translateY(-50%);
	}
</style>
