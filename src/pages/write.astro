---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import categories from '../categories.json';
import { NODE_GROUPS } from '../lib/contribute/godot-nodes.ts';
import { dark, light } from '../styles/palette.mjs';
import { godotTheme } from '../styles/code-theme.mjs';

const codeThemes = { dark: godotTheme('godot-4-modern', 'dark', dark), light: godotTheme('godot-4-light', 'light', light) };

// The site key is public. The local .env swaps in Turnstile's always-pass
// test key, since the real widget only renders on queuefree.dev.
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '0x4AAAAAAFUhulcfDk5zdVB0';
---

<StarlightPage
	hasSidebar={false}
	frontmatter={{
		title: 'Write a page',
		description: 'Propose a new Queue Free page without touching code. It goes to review before it is published.',
		tableOfContents: false,
		pagefind: false,
		lastUpdated: false,
	}}
>
	<div class="qf-contribute not-content" id="qf-contribute" data-site-key={siteKey} data-categories={JSON.stringify(categories)} data-node-groups={JSON.stringify(NODE_GROUPS)} data-code-themes={JSON.stringify(codeThemes)}>
		<div class="modes-bar">
			<div class="modes" role="tablist">
				<button type="button" data-action="set-mode" data-mode="write" aria-selected="true">Write</button>
				<button type="button" data-action="set-mode" data-mode="preview" aria-selected="false">Preview</button>
				<button type="button" data-action="set-mode" data-mode="source" aria-selected="false">Source</button>
			</div>
		</div>

		<p class="intro">
			Fill in the form, check the preview, and send it. Your page will be reviewed as soon as possible before it goes
			live.
		</p>

		<section class="panel" data-panel="write">
			<div id="qf-form"></div>
			{
				siteKey ? (
					<div class="turnstile" id="qf-turnstile" />
				) : (
					<p class="notice">Submitting is off: this build has no Turnstile site key.</p>
				)
			}
			<div class="submit-row">
				<button type="button" class="primary" data-action="submit" id="qf-submit" disabled={!siteKey}>
					Send for review
				</button>
				<button type="button" data-action="reset">Start over</button>
			</div>
			<div class="summary" id="qf-summary" hidden></div>
		</section>

		<section class="panel" data-panel="preview" hidden>
			<div class="preview sl-markdown-content" id="qf-preview"></div>
		</section>

		<section class="panel" data-panel="source" hidden>
			<p class="hint">This is the file the form will add to the site. You never need to edit it.</p>
			<div class="source-row"><button type="button" data-action="copy-source">Copy</button></div>
			<pre id="qf-source"></pre>
		</section>

		<section class="panel done" data-panel="done" hidden>
			<h2>Sent for review</h2>
			<p id="qf-done-text">Thanks. Your page is now a pull request. You can follow the review there:</p>
			<p><a id="qf-pr-link" href="#" target="_blank" rel="noopener">View the pull request</a></p>
			<button type="button" data-action="reset">Write another page</button>
		</section>

		<dialog class="node-picker" id="qf-node-picker" aria-label="Create new node">
			<div class="picker-head">
				<input type="search" id="qf-node-search" placeholder="Search nodes" autocomplete="off" spellcheck="false" />
				<button type="button" class="small" data-action="tree-cancel">Cancel</button>
			</div>
			<div class="picker-list" id="qf-node-list"></div>
		</dialog>
	</div>
</StarlightPage>

{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer />}

<script>
	import { generateMdx, pagePath } from '../lib/contribute/mdx.ts';
	import { plainLines } from '../lib/contribute/code-lines.ts';
	import type { CodeThemes, Highlighter } from '../lib/contribute/highlight.ts';
	import {
		LIMITS,
		headingAnchor,
		headingTexts,
		labelFromTitle,
		slugify,
		validateSubmission,
		type Block,
		type BlockType,
		type Categories,
		type Issue,
		type Page,
		type PageKind,
	} from '../lib/contribute/schema.ts';

	type Mode = 'write' | 'preview' | 'source' | 'done';

	interface Draft {
		page: Page;
		contributor: string;
		notes: string;
		slugTouched: boolean;
		labelTouched: boolean;
		newCategory: boolean;
		categoryTouched: boolean;
	}

	declare global {
		interface Window {
			turnstile?: {
				render(el: HTMLElement, options: Record<string, unknown>): string;
				reset(id?: string): void;
				getResponse(id?: string): string | undefined;
			};
		}
	}

	const DRAFT_KEY = 'qf-contribute-draft';

	const BLOCK_NAMES: Record<BlockType, string> = {
		heading: 'Section heading',
		prose: 'Plain text',
		code: 'Code',
		tabs: 'Code blocks',
		tree: 'Scene tree',
		callout: 'Callout',
		error: 'Error message',
		steps: 'Steps',
		causes: 'Cause table',
	};

	const BLOCK_HELP: Partial<Record<BlockType, string>> = {
		tree: 'Use + to add a child node, rename it, and mark the node that holds the script.',
	};


	const esc = (s: string) =>
		s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

	function newBlock(type: BlockType): Block {
		switch (type) {
			case 'heading':
				return { type, text: '' };
			case 'prose':
				return { type, text: '' };
			case 'code':
				return { type, lang: 'gdscript', filename: 'main.gd', code: '', wrong: '', right: '' };
			case 'tabs':
				return { type, gdscript: { filename: 'main.gd', code: '' }, csharp: { filename: 'Main.cs', code: '' } };
			case 'tree':
				return { type, text: 'Main: Node2D [script]\n  Child: Sprite2D' };
			case 'callout':
				return { type, kind: 'note', title: '', text: '' };
			case 'error':
				return { type, message: '' };
			case 'steps':
				return { type, items: [''] };
			case 'causes':
				return { type, rows: [{ symptom: '', section: '' }] };
		}
	}

	function templateBlocks(kind: PageKind): Block[] {
		if (kind === 'error') {
			return [
				{ type: 'heading', text: 'The error' },
				{ type: 'prose', text: "You'll see something like this in the **Debugger** panel. The names will be your own:" },
				{ type: 'error', message: '' },
				{ type: 'heading', text: 'Which cause is it?' },
				{
					type: 'causes',
					rows: [
						{ symptom: '', section: 'First cause' },
						{ symptom: '', section: 'Second cause' },
					],
				},
				{ type: 'heading', text: 'The example scene' },
				newBlock('tree'),
				{ type: 'heading', text: 'First cause' },
				{ type: 'prose', text: '' },
				{ type: 'code', lang: 'gdscript', filename: 'main.gd', code: '', wrong: '', right: '' },
				{ type: 'heading', text: 'Second cause' },
				{ type: 'prose', text: '' },
				{ type: 'heading', text: 'Still stuck?' },
				{ type: 'prose', text: '' },
			];
		}
		return [
			{ type: 'heading', text: 'Set up the scene' },
			newBlock('tree'),
			{ type: 'steps', items: [''] },
			{ type: 'heading', text: 'Add the script' },
			newBlock('tabs'),
			{ type: 'prose', text: '' },
			{ type: 'heading', text: 'Common mistakes' },
			{ type: 'callout', kind: 'note', title: '', text: '' },
		];
	}

	function newDraft(known: Categories, kind: PageKind = 'how-to'): Draft {
		const firstTopic = Object.keys(known).find((k) => k !== 'errors') ?? '';
		return {
			page: {
				kind,
				category: kind === 'error' ? 'errors' : firstTopic,
				categoryLabel: '',
				title: '',
				description: '',
				label: '',
				slug: '',
				shortAnswer: '',
				blocks: templateBlocks(kind),
			},
			contributor: '',
			notes: '',
			slugTouched: false,
			labelTouched: false,
			newCategory: false,
			categoryTouched: false,
		};
	}

	function loadDraft(known: Categories): Draft {
		try {
			const raw = localStorage.getItem(DRAFT_KEY);
			if (raw) {
				const d = JSON.parse(raw) as Draft;
				if (d?.page?.blocks) return { ...newDraft(known), ...d, page: { ...newDraft(known).page, ...d.page } };
			}
		} catch {}
		return newDraft(known);
	}

	function getPath(obj: unknown, path: string): unknown {
		return path.split('.').reduce<any>((o, k) => (o == null ? undefined : o[k]), obj);
	}

	function setPath(obj: unknown, path: string, value: unknown) {
		const keys = path.split('.');
		const last = keys.pop()!;
		const target = keys.reduce<any>((o, k) => o[k], obj);
		target[last] = value;
	}

	// Scene tree: the block stores the text form, the editor works on nodes.

	interface TreeNode {
		name: string;
		type: string;
		script: boolean;
		unique: boolean;
		note: string;
		children: TreeNode[];
	}

	const TREE_LINE = /^(\s*)([^:"\[]+?)\s*(?::\s*(\w+))?\s*((?:\[\w+\]\s*)*)(?:"(.*)")?\s*$/;
	const treeTextMode = new Set<number>();

	function parseTree(text: string): TreeNode[] | null {
		const lines = text.split('\n').filter((l) => l.trim());
		if (!lines.length) return [];
		const base = Math.min(...lines.map((l) => l.match(/^\s*/)![0].length));
		const roots: TreeNode[] = [];
		const stack: { depth: number; node: TreeNode }[] = [];
		for (const line of lines) {
			const m = line.match(TREE_LINE);
			if (!m) return null;
			const depth = Math.floor((m[1]!.length - base) / 2);
			const node: TreeNode = {
				name: m[2]!,
				type: m[3] ?? 'Node',
				script: m[4]!.includes('[script]'),
				unique: m[4]!.includes('[unique]'),
				note: m[5] ?? '',
				children: [],
			};
			while (stack.length && stack[stack.length - 1]!.depth >= depth) stack.pop();
			(stack.length ? stack[stack.length - 1]!.node.children : roots).push(node);
			stack.push({ depth, node });
		}
		return roots;
	}

	function serializeTree(nodes: TreeNode[], depth = 0): string {
		return nodes
			.map((n) => {
				const flags = (n.script ? ' [script]' : '') + (n.unique ? ' [unique]' : '');
				const note = n.note.trim() ? ` "${n.note.trim()}"` : '';
				const line = `${'  '.repeat(depth)}${n.name}: ${n.type}${flags}${note}`;
				return n.children.length ? line + '\n' + serializeTree(n.children, depth + 1) : line;
			})
			.join('\n');
	}

	function treeSiblings(roots: TreeNode[], path: string): TreeNode[] {
		if (!path) return roots;
		let list = roots;
		for (const index of path.split('.')) list = list[Number(index)]!.children;
		return list;
	}

	function treeNodeAt(roots: TreeNode[], path: string): TreeNode {
		const indexes = path.split('.').map(Number);
		const last = indexes.pop()!;
		let list = roots;
		for (const index of indexes) list = list[index]!.children;
		return list[last]!;
	}

	function uniqueNodeName(siblings: TreeNode[], type: string): string {
		const taken = new Set(siblings.map((n) => n.name));
		if (!taken.has(type)) return type;
		let n = 2;
		while (taken.has(`${type}${n}`)) n++;
		return `${type}${n}`;
	}

	const icon = (type: string) => `/godot-editor-icons/${esc(type)}.svg`;

	function renderTreeRows(nodes: TreeNode[], block: number, parentPath: string, depth: number): string {
		return nodes
			.map((n, j) => {
				const path = parentPath ? `${parentPath}.${j}` : `${j}`;
				const toggle = (fieldName: 'script' | 'unique', on: boolean, iconName: string, title: string) =>
					`<button type="button" class="tree-flag" data-action="tree-toggle" data-index="${block}" data-tree-path="${path}" data-field="${fieldName}" aria-pressed="${on}" title="${title}"><img src="${icon(iconName)}" alt="" width="16" height="16"></button>`;
				const row = `<div class="tree-row">
					<span class="tree-head" style="--depth: ${depth}">
						<img class="tree-icon" src="${icon(n.type)}" alt="" width="16" height="16" onerror="this.style.visibility='hidden'">
						<input type="text" class="tree-name" data-tree-block="${block}" data-tree-path="${path}" data-tree-field="name" value="${esc(n.name)}" aria-label="Node name">
					</span>
					<span class="tree-type">${esc(n.type)}</span>
					<span class="tree-flags">${toggle('script', n.script, 'Script', 'Has a script')}${toggle('unique', n.unique, 'SceneUniqueName', 'Access as unique name (%)')}</span>
					<input type="text" class="tree-note" data-tree-block="${block}" data-tree-path="${path}" data-tree-field="note" value="${esc(n.note)}" placeholder="Note" aria-label="Note">
					<span class="tree-tools">
						<button type="button" class="small" data-action="tree-add" data-index="${block}" data-parent="${path}" title="Add child node">+</button>
						<button type="button" class="small" data-action="tree-move" data-index="${block}" data-tree-path="${path}" data-dir="-1" ${j === 0 ? 'disabled' : ''} aria-label="Move up">↑</button>
						<button type="button" class="small" data-action="tree-move" data-index="${block}" data-tree-path="${path}" data-dir="1" ${j === nodes.length - 1 ? 'disabled' : ''} aria-label="Move down">↓</button>
						<button type="button" class="small" data-action="tree-remove" data-index="${block}" data-tree-path="${path}" aria-label="Remove node">✕</button>
					</span>
				</div>`;
				return row + renderTreeRows(n.children, block, path, depth + 1);
			})
			.join('');
	}

	function renderTreeEditor(block: number, text: string): string {
		const nodes = treeTextMode.has(block) ? null : parseTree(text);
		if (!nodes) {
			const note = treeTextMode.has(block) ? '' : `<span class="error">Could not read this tree. Fix it here or clear it.</span>`;
			return (
				field('Nodes', `page.blocks.${block}.text`, textarea(`page.blocks.${block}.text`, text, 5, 'class="code" spellcheck="false"'), 'One node per line as Name: Type, children indented by two spaces.') +
				note +
				`<div class="tree-foot"><button type="button" class="small" data-action="tree-visual" data-index="${block}">Back to the visual editor</button></div>`
			);
		}
		const body = nodes.length
			? `<div class="tree-grid">${renderTreeRows(nodes, block, '', 0)}</div>`
			: `<button type="button" class="small" data-action="tree-add" data-index="${block}" data-parent="">Add root node</button>`;
		return `<div class="tree-editor">${body}</div>
			<div class="tree-foot"><button type="button" class="small" data-action="tree-text" data-index="${block}">Edit as text</button></div>
			<span class="error" data-error-for="page.blocks.${block}.text"></span>`;
	}

	// Form rendering

	const field = (label: string, path: string, control: string, hint = '') =>
		`<label class="field"><span class="label">${esc(label)}</span>${hint ? `<span class="hint">${hint}</span>` : ''}${control}<span class="error" data-error-for="${path}"></span></label>`;

	// A control without its own label, for blocks whose name says what it is.
	const bare = (path: string, control: string) => `<div class="field">${control}<span class="error" data-error-for="${path}"></span></div>`;

	const input = (path: string, value: string, attrs = '') =>
		`<input type="text" data-path="${path}" value="${esc(value)}" ${attrs}>`;

	const textarea = (path: string, value: string, rows: number, attrs = '') =>
		`<textarea data-path="${path}" rows="${rows}" ${attrs}>${esc(value)}</textarea>`;

	// Marks are stored as a line spec like "2" or "1-3,5"; the editor toggles them per line.
	function lineSpec(lines: Set<number>): string {
		const sorted = [...lines].sort((a, b) => a - b);
		const parts: string[] = [];
		for (let k = 0; k < sorted.length; k++) {
			const from = sorted[k]!;
			let to = from;
			while (k + 1 < sorted.length && sorted[k + 1] === to + 1) to = sorted[++k]!;
			parts.push(from === to ? `${from}` : `${from}-${to}`);
		}
		return parts.join(',');
	}

	const MARK_ICONS = {
		right: '<svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M4.5 10.5l3.5 3.5 7.5-8" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>',
		wrong: '<svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M5.5 5.5l9 9m0-9l-9 9" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>',
	};

	function lineMarks(block: number, code: string, wrong: string, right: string): string {
		const del = lineSet(wrong);
		const ins = lineSet(right);
		const count = code.split('\n').length;
		let html = '';
		for (let n = 1; n <= count; n++) {
			const toggle = (mark: 'right' | 'wrong', on: boolean, title: string) =>
				`<button type="button" class="line-mark-${mark}" data-action="mark-line" data-index="${block}" data-line="${n}" data-mark="${mark}" aria-pressed="${on}" title="${title}" aria-label="Line ${n}: ${title}" tabindex="-1">${MARK_ICONS[mark]}</button>`;
			html += `<span class="line-mark">${toggle('right', ins.has(n), 'Mark as correct')}${toggle('wrong', del.has(n), 'Mark as wrong')}</span>`;
		}
		return html;
	}

	const codeArea = (path: string, value: string, rows: number, lang: string, wrong = '', right = '', markBlock = -1) =>
		`<div class="code-editor${markBlock >= 0 ? ' with-marks' : ''}"><pre class="code-highlight" aria-hidden="true"><code>${plainLines(value)}</code></pre>` +
		`<textarea data-path="${path}" rows="${rows}" class="code" spellcheck="false" autocapitalize="off" autocomplete="off" data-lang="${lang}" data-wrong="${esc(wrong)}" data-right="${esc(right)}">${esc(value)}</textarea>` +
		(markBlock >= 0 ? `<div class="line-marks" data-marks-for="${markBlock}">${lineMarks(markBlock, value, wrong, right)}</div>` : '') +
		`</div>`;

	const langSwitch = (block: number, lang: string) =>
		`<div class="switch" role="radiogroup" aria-label="Language">` +
		(['gdscript', 'csharp'] as const)
			.map((l) => `<button type="button" role="radio" data-action="set-lang" data-index="${block}" data-lang="${l}" aria-checked="${lang === l}">${l === 'gdscript' ? 'GDScript' : 'C#'}</button>`)
			.join('') +
		`</div>`;

	const group = (label: string, path: string, control: string) =>
		`<div class="field"><span class="label">${esc(label)}</span>${control}<span class="error" data-error-for="${path}"></span></div>`;

	const select = (path: string, value: string, options: [string, string][]) =>
		`<select data-path="${path}">${options
			.map(([v, label]) => `<option value="${v}"${v === value ? ' selected' : ''}>${esc(label)}</option>`)
			.join('')}</select>`;

	function codeFields(path: string, snippet: { filename: string; code: string }, lang: string) {
		return (
			field('File name', `${path}.filename`, input(`${path}.filename`, snippet.filename, 'placeholder="main.gd"')) +
			field(lang, `${path}.code`, codeArea(`${path}.code`, snippet.code, 8, path.includes('.csharp') ? 'csharp' : 'gdscript'))
		);
	}

	const sectionPick = (path: string, value: string, headings: string[]) =>
		select(path, value, [['', 'Pick a section'], ...headings.map((h): [string, string] => [h, h])]).replace('<select ', '<select data-section-pick ');

	function renderBlock(block: Block, i: number, count: number, headings: string[]): string {
		const p = `page.blocks.${i}`;
		let body = '';
		switch (block.type) {
			case 'heading':
				body = bare(`${p}.text`, input(`${p}.text`, block.text, 'aria-label="Section heading"'));
				break;
			case 'prose':
				body = bare(`${p}.text`, textarea(`${p}.text`, block.text, 4, 'aria-label="Plain text"'));
				break;
			case 'code':
				body =
					`<div class="row">` +
					group('Language', `${p}.lang`, langSwitch(i, block.lang)) +
					field('File name', `${p}.filename`, input(`${p}.filename`, block.filename)) +
					`</div>` +
					field('Code', `${p}.code`, codeArea(`${p}.code`, block.code, 8, block.lang, block.wrong, block.right, i)) +
					`<span class="error" data-error-for="${p}.wrong"></span><span class="error" data-error-for="${p}.right"></span>`;
				break;
			case 'tabs':
				body =
					`<div class="sub">${codeFields(`${p}.gdscript`, block.gdscript, 'GDScript')}</div>` +
					`<div class="sub">${codeFields(`${p}.csharp`, block.csharp, 'C# (optional)')}</div>`;
				break;
			case 'tree':
				body = renderTreeEditor(i, block.text);
				break;
			case 'callout':
				body =
					`<div class="row">` +
					field('Type', `${p}.kind`, select(`${p}.kind`, block.kind, [['note', 'Note'], ['tip', 'Tip'], ['caution', 'Caution']])) +
					field('Title', `${p}.title`, input(`${p}.title`, block.title)) +
					`</div>` +
					field('Text', `${p}.text`, textarea(`${p}.text`, block.text, 3));
				break;
			case 'error':
				body = bare(`${p}.message`, textarea(`${p}.message`, block.message, 3, 'class="code" spellcheck="false" aria-label="Error message"'));
				break;
			case 'steps':
				body =
					`<ol class="steps">` +
					block.items
						.map(
							(item, j) =>
								`<li>${field(`Step ${j + 1}`, `${p}.items.${j}`, textarea(`${p}.items.${j}`, item, 2))}` +
								`<button type="button" class="small" data-action="remove-step" data-index="${i}" data-item="${j}">Remove step</button></li>`,
						)
						.join('') +
					`</ol><button type="button" class="small" data-action="add-step" data-index="${i}">Add a step</button>` +
					`<span class="error" data-error-for="${p}.items"></span>`;
				break;
			case 'causes':
				body =
					`<div class="causes">` +
					block.rows
						.map(
							(row, j) =>
								`<div class="row">` +
								field("What's happening", `${p}.rows.${j}.symptom`, input(`${p}.rows.${j}.symptom`, row.symptom, 'placeholder="The error includes `Node not found`"')) +
								field('Go to', `${p}.rows.${j}.section`, sectionPick(`${p}.rows.${j}.section`, row.section, headings)) +
								`<button type="button" class="small" data-action="remove-cause" data-index="${i}" data-item="${j}">Remove</button></div>`,
						)
						.join('') +
					`</div><button type="button" class="small" data-action="add-cause" data-index="${i}">Add a row</button>` +
					`<span class="error" data-error-for="${p}.rows"></span>`;
				break;
		}
		const help = BLOCK_HELP[block.type];
		return `<div class="block" data-block="${i}">
			<div class="block-head">
				<span class="block-name">${BLOCK_NAMES[block.type]}</span>
				<span class="block-tools">
					<button type="button" class="icon" data-action="move-block" data-index="${i}" data-dir="-1" ${i === 0 ? 'disabled' : ''} aria-label="Move up" title="Move up" data-icon="move_up"></button>
					<button type="button" class="icon" data-action="move-block" data-index="${i}" data-dir="1" ${i === count - 1 ? 'disabled' : ''} aria-label="Move down" title="Move down" data-icon="move_down"></button>
					<button type="button" class="icon" data-action="remove-block" data-index="${i}" aria-label="Remove block" title="Remove" data-icon="remove"></button>
				</span>
			</div>
			${help ? `<p class="hint">${help}</p>` : ''}
			${body}
		</div>`;
	}

	function renderForm(draft: Draft, categories: Categories): string {
		const { page } = draft;
		const categoryOptions: [string, string][] = [...Object.entries(categories), ['__new__', 'New category...']];
		const categoryPick = `<select data-pick-category>${categoryOptions
			.map(([v, label]) => `<option value="${v}"${(draft.newCategory ? '__new__' : page.category) === v ? ' selected' : ''}>${esc(label)}</option>`)
			.join('')}</select>`;
		const newCategoryFields = draft.newCategory
			? `<div class="row new-category">
				${field('Category name', 'page.categoryLabel', input('page.categoryLabel', page.categoryLabel, `placeholder="User interface" maxlength="${LIMITS.label}"`), 'Shown in the sidebar.')}
				${field('Folder', 'page.category', input('page.category', page.category, 'placeholder="user-interface"'), 'Part of the address.')}
			</div>`
			: '';
		const kinds: [PageKind, string, string][] = [
			['how-to', 'How do I...?', 'A task, with the scene and the script that does it.'],
			['error', 'Why does this error...?', 'An error message, what causes it, and the fix.'],
		];
		return `
		<fieldset class="kinds">
			<legend>What kind of page is it?</legend>
			<div class="kind-list">
			${kinds
				.map(
					([k, label, hint]) => `<label class="kind${page.kind === k ? ' selected' : ''}">
					<input type="radio" name="kind" value="${k}" data-action="set-kind" ${page.kind === k ? 'checked' : ''}>
					<span class="label">${label}</span><span class="hint">${hint}</span></label>`,
				)
				.join('')}
			</div>
		</fieldset>

		${field('Title', 'page.title', input('page.title', page.title, `placeholder="${page.kind === 'error' ? 'Why does it say ...?' : 'How do I ...?'}" maxlength="${LIMITS.title}"`), 'Write it as the question people search for.')}
		${field('Description', 'page.description', textarea('page.description', page.description, 2, `maxlength="${LIMITS.description}"`), 'One sentence shown in search results.')}
		<div class="row">
			${field('Category', 'page.category', categoryPick)}
			${field('Sidebar name', 'page.label', input('page.label', page.label, `maxlength="${LIMITS.label}"`))}
		</div>
		${newCategoryFields}
		${field('Address', 'page.slug', `<span class="slug"><span class="prefix">queuefree.dev/${esc(page.category)}/</span>${input('page.slug', page.slug)}</span>`)}
		${field('Short answer', 'page.shortAnswer', textarea('page.shortAnswer', page.shortAnswer, 3, `maxlength="${LIMITS.shortAnswer}"`), 'One or two sentences. This is what most readers come for.')}

		<h2>Content</h2>
		<div class="blocks">${page.blocks.map((b, i) => renderBlock(b, i, page.blocks.length, headingTexts(page.blocks))).join('')}</div>
		<span class="error" data-error-for="page.blocks"></span>
		<div class="add-block">
			<span class="label">Add</span>
			${(Object.keys(BLOCK_NAMES) as BlockType[]).map((t) => `<button type="button" class="small" data-action="add-block" data-type="${t}">${BLOCK_NAMES[t]}</button>`).join('')}
		</div>

		<h2>About you</h2>
		${renderGithubCard()}
		${field('Name or handle (optional)', 'contributor', input('contributor', draft.contributor), 'Shown on the pull request, not on the page.')}
		${field('Notes for the reviewer (optional)', 'notes', textarea('notes', draft.notes, 2))}
		`;
	}

	// Preview rendering

	// Which language the preview's code tabs show, shared by every tab group.
	let previewLang: 'gdscript' | 'csharp' = 'gdscript';

	// GitHub sign-in, optional: when available, the pull request can be the
	// contributor's own so they get credit for it.
	interface GithubUser {
		login: string;
		avatar: string;
	}
	let githubAvailable = false;
	let githubUser: GithubUser | null = null;

	function renderGithubCard(): string {
		if (!githubAvailable) return '';
		if (githubUser) {
			return `<div class="github-card">
				${githubUser.avatar ? `<img class="avatar" src="${esc(githubUser.avatar)}" alt="" width="32" height="32">` : ''}
				<span class="who">Signed in as <strong>${esc(githubUser.login)}</strong>. The pull request will be opened from your account.</span>
				<button type="button" class="small" data-action="github-logout">Sign out</button>
			</div>`;
		}
		return `<div class="github-card">
			<span class="who">Sign in with GitHub to open the pull request as yourself and get credit as a contributor. Optional.</span>
			<a class="button-link" href="/api/github/login">Sign in with GitHub</a>
			<span class="hint">GitHub will ask to let the form fork this site and open pull requests for you. Nothing else is stored.</span>
		</div>`;
	}

	function inlineMd(text: string): string {
		return esc(text)
			.replace(/`([^`]+)`/g, '<code>$1</code>')
			.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
			.replace(/(^|\s)\*([^*\s][^*]*)\*/g, '$1<em>$2</em>');
	}

	function paragraphs(text: string): string {
		return text
			.trim()
			.split(/\n\s*\n/)
			.filter(Boolean)
			.map((p) => `<p>${inlineMd(p).replace(/\n/g, '<br>')}</p>`)
			.join('');
	}

	function lineSet(spec: string): Set<number> {
		const set = new Set<number>();
		for (const part of spec.split(',')) {
			const m = part.trim().match(/^(\d+)(?:-(\d+))?$/);
			if (!m) continue;
			const from = Number(m[1]);
			const to = m[2] ? Number(m[2]) : from;
			for (let n = from; n <= to; n++) set.add(n);
		}
		return set;
	}

	function codePreview(code: string, lang: string, filename: string, wrong = '', right = ''): string {
		const trimmed = code.replace(/\s+$/, '');
		const rows = plainLines(trimmed, { numbers: true, del: lineSet(wrong), ins: lineSet(right) });
		return `<figure class="qf-pre">${filename.trim() ? `<figcaption>${esc(filename)}</figcaption>` : ''}<pre><code data-lang="${lang}" data-wrong="${esc(wrong)}" data-right="${esc(right)}" data-code="${esc(trimmed)}">${rows}</code></pre></figure>`;
	}

	function treePreview(text: string): string {
		const lines = text.split('\n').filter((l) => l.trim());
		if (!lines.length) return '';
		const base = Math.min(...lines.map((l) => l.match(/^\s*/)![0].length));
		let html = '';
		let depth = -1;
		for (const line of lines) {
			const m = line.match(/^(\s*)([^:"\[]+?)\s*(?::\s*(\w+))?\s*((?:\[\w+\]\s*)*)(?:"(.*)")?\s*$/);
			if (!m) return `<p class="qf-bad">Can't read the line "${esc(line.trim())}".</p>`;
			const d = Math.floor((m[1].length - base) / 2);
			const type = m[3] ?? 'Node';
			if (d > depth) html += '<ul>'.repeat(d - depth);
			else {
				html += '</li>' + '</ul></li>'.repeat(depth - d);
			}
			html += `<li><span class="row"><img src="/godot-editor-icons/${esc(type)}.svg" alt="" width="16" height="16" onerror="this.style.visibility='hidden'"><span class="name">${esc(m[2])}</span><span class="type">${esc(type)}</span>${m[4].includes('[script]') ? '<img src="/godot-editor-icons/Script.svg" alt="has script" width="16" height="16">' : ''}${m[5] ? `<span class="note">${esc(m[5])}</span>` : ''}</span>`;
			depth = d;
		}
		html += '</li>' + '</ul></li>'.repeat(depth) + '</ul>';
		return `<div class="qf-tree">${html}</div>`;
	}

	function aside(kind: string, title: string, inner: string): string {
		return `<aside class="starlight-aside starlight-aside--${kind}"><p class="starlight-aside__title">${esc(title)}</p><div class="starlight-aside__content">${inner}</div></aside>`;
	}

	// Preview headings get the ids the built page will have, so cause table
	// links work in the preview too.
	function previewAnchors(blocks: Block[]): Map<Block, string> {
		const seen = new Map<string, number>();
		const anchors = new Map<Block, string>();
		for (const block of blocks) {
			if (block.type !== 'heading') continue;
			const base = headingAnchor(block.text);
			const n = seen.get(base) ?? 0;
			seen.set(base, n + 1);
			anchors.set(block, n ? `${base}-${n}` : base);
		}
		return anchors;
	}

	function previewBlock(block: Block, anchors: Map<Block, string>): string {
		switch (block.type) {
			case 'heading':
				return `<h2 id="${esc(anchors.get(block) ?? '')}">${esc(block.text)}</h2>`;
			case 'prose':
				return paragraphs(block.text);
			case 'code':
				return codePreview(block.code, block.lang, block.filename, block.wrong, block.right);
			case 'tabs':
				{
					const hasCsharp = block.csharp.code.trim() !== '';
					const open = hasCsharp ? previewLang : 'gdscript';
					const tab = (lang: 'gdscript' | 'csharp', label: string) =>
						`<button type="button" role="tab" data-action="preview-tab" data-lang="${lang}" aria-selected="${open === lang}">${label}</button>`;
					const panel = (lang: 'gdscript' | 'csharp', html: string) => `<div role="tabpanel" data-tab-panel="${lang}" ${open === lang ? '' : 'hidden'}>${html}</div>`;
					return (
						`<div class="qf-tabs"><div class="tab-bar" role="tablist">${tab('gdscript', 'GDScript')}${hasCsharp ? tab('csharp', 'C#') : ''}</div>` +
						panel('gdscript', codePreview(block.gdscript.code, 'gdscript', block.gdscript.filename)) +
						(hasCsharp ? panel('csharp', codePreview(block.csharp.code, 'csharp', block.csharp.filename)) : '') +
						`</div>`
					);
				}
			case 'tree':
				return treePreview(block.text);
			case 'callout':
				return aside(block.kind, block.title || block.kind, paragraphs(block.text));
			case 'error':
				return `<div class="qf-godot-error"><span class="dot"></span><span>${esc(block.message)}</span></div>`;
			case 'steps':
				return `<ol class="qf-steps">${block.items.map((s) => `<li>${paragraphs(s)}</li>`).join('')}</ol>`;
			case 'causes': {
				const rows = block.rows.map((r) => {
					const section = r.section.trim();
					const target = section ? `<a href="#${esc(headingAnchor(section))}">${inlineMd(section)}</a>` : '<span class="qf-empty">Pick a section</span>';
					return `<tr><td>${inlineMd(r.symptom)}</td><td>${target}</td></tr>`;
				});
				return `<table class="qf-causes"><thead><tr><th>What's happening</th><th>Go to</th></tr></thead><tbody>${rows.join('')}</tbody></table>`;
			}
		}
	}

	function renderPreview(page: Page): string {
		const anchors = previewAnchors(page.blocks);
		const parts = [
			`<h1>${esc(page.title) || '<span class="qf-empty">Untitled page</span>'}</h1>`,
			`<p class="qf-meta"><span class="pill">Godot 4.x</span></p>`,
			aside('tip', 'Short answer', paragraphs(page.shortAnswer)),
			...page.blocks.map((b) => previewBlock(b, anchors)),
		];
		return parts.join('');
	}

	// Controller

	function init(root: HTMLElement) {
		if (root.dataset.ready) return;
		root.dataset.ready = '1';

		const categories = JSON.parse(root.dataset.categories ?? '{}') as Categories;
		const nodeGroups = JSON.parse(root.dataset.nodeGroups ?? '[]') as { label: string; types: string[] }[];
		const codeThemes = JSON.parse(root.dataset.codeThemes ?? 'null') as CodeThemes | null;
		let highlighter: Highlighter | null = null;
		const highlightTimers = new WeakMap<HTMLTextAreaElement, number>();

		const highlightField = (el: HTMLTextAreaElement) => {
			const layer = el.parentElement?.querySelector<HTMLElement>('.code-highlight code');
			if (!layer) return;
			const lang = (el.dataset.lang ?? 'txt') as 'gdscript' | 'csharp' | 'txt';
			const opts = { del: lineSet(el.dataset.wrong ?? ''), ins: lineSet(el.dataset.right ?? '') };
			layer.innerHTML = highlighter ? highlighter.lines(el.value, lang, opts) : plainLines(el.value, opts);
			const marks = el.parentElement?.querySelector<HTMLElement>('.line-marks');
			if (marks) marks.innerHTML = lineMarks(Number(marks.dataset.marksFor), el.value, el.dataset.wrong ?? '', el.dataset.right ?? '');
		};

		const scheduleHighlight = (el: HTMLTextAreaElement) => {
			clearTimeout(highlightTimers.get(el));
			highlightTimers.set(el, window.setTimeout(() => highlightField(el), 40));
		};

		const highlightForm = () => {
			for (const el of formEl.querySelectorAll<HTMLTextAreaElement>('textarea.code')) highlightField(el);
		};

		const highlightPreview = () => {
			if (!highlighter) return;
			for (const code of previewEl.querySelectorAll<HTMLElement>('.qf-pre code[data-code]')) {
				const lang = (code.dataset.lang ?? 'txt') as 'gdscript' | 'csharp' | 'txt';
				code.innerHTML = highlighter.lines(code.dataset.code ?? '', lang, {
					numbers: true,
					del: lineSet(code.dataset.wrong ?? ''),
					ins: lineSet(code.dataset.right ?? ''),
				});
			}
		};

		fetch('/api/github/me', { cache: 'no-store' })
			.then((r) => (r.ok ? r.json() : null))
			.then((data: { available?: boolean; user?: GithubUser | null } | null) => {
				if (!data) return;
				githubAvailable = Boolean(data.available);
				githubUser = data.user ?? null;
				if (githubUser && !draft.contributor.trim()) {
					draft.contributor = githubUser.login;
					save();
				}
				const card = formEl.querySelector('.github-card');
				if (githubAvailable && !card) renderAll();
				else if (card) card.outerHTML = renderGithubCard();
				const input = formEl.querySelector<HTMLInputElement>('[data-path="contributor"]');
				if (input && !input.value) input.value = draft.contributor;
			})
			.catch(() => {});

		if (codeThemes) {
			import('../lib/contribute/highlight.ts')
				.then((m) => m.Highlighter.create(codeThemes))
				.then((h) => {
					highlighter = h;
					highlightForm();
					highlightPreview();
				})
				.catch(() => {});
		}

		root.addEventListener(
			'scroll',
			(e) => {
				const el = e.target as HTMLElement;
				if (!(el instanceof HTMLTextAreaElement) || !el.classList.contains('code')) return;
				const layer = el.parentElement?.querySelector<HTMLElement>('.code-highlight');
				if (layer) {
					layer.scrollTop = el.scrollTop;
					layer.scrollLeft = el.scrollLeft;
				}
				const marks = el.parentElement?.querySelector<HTMLElement>('.line-marks');
				if (marks) marks.style.transform = `translateY(${-el.scrollTop}px)`;
			},
			true,
		);
		const picker = root.querySelector<HTMLDialogElement>('#qf-node-picker')!;
		const pickerSearch = root.querySelector<HTMLInputElement>('#qf-node-search')!;
		const pickerList = root.querySelector<HTMLElement>('#qf-node-list')!;
		let pickerTarget: { block: number; parent: string } | null = null;
		const formEl = root.querySelector<HTMLElement>('#qf-form')!;
		const previewEl = root.querySelector<HTMLElement>('#qf-preview')!;
		const sourceEl = root.querySelector<HTMLElement>('#qf-source')!;
		const summaryEl = root.querySelector<HTMLElement>('#qf-summary')!;
		const submitBtn = root.querySelector<HTMLButtonElement>('#qf-submit')!;
		const siteKey = root.dataset.siteKey ?? '';

		let draft = loadDraft(categories);
		let previewTimer = 0;
		let turnstileId: string | undefined;

		const save = () => {
			try {
				localStorage.setItem(DRAFT_KEY, JSON.stringify(draft));
			} catch {}
		};

		const refreshOutputs = () => {
			previewEl.innerHTML = renderPreview(draft.page);
			sourceEl.textContent = generateMdx(draft.page);
			highlightPreview();
		};

		const scheduleOutputs = () => {
			clearTimeout(previewTimer);
			previewTimer = window.setTimeout(refreshOutputs, 150);
		};

		const renderAll = () => {
			formEl.innerHTML = renderForm(draft, categories);
			highlightForm();
			refreshOutputs();
		};

		let currentMode: Mode = 'write';
		const scrollByMode: Partial<Record<Mode, number>> = {};

		const setMode = (mode: Mode) => {
			if (mode === currentMode) return;
			scrollByMode[currentMode] = window.scrollY;
			currentMode = mode;
			for (const panel of root.querySelectorAll<HTMLElement>('[data-panel]')) panel.hidden = panel.dataset.panel !== mode;
			for (const b of root.querySelectorAll<HTMLElement>('[data-mode]')) b.setAttribute('aria-selected', String(b.dataset.mode === mode));
			if (mode !== 'write') refreshOutputs();
			root.toggleAttribute('data-done', mode === 'done');
			window.scrollTo({ top: mode === 'done' ? 0 : (scrollByMode[mode] ?? 0) });
		};

		const clearIssues = () => {
			for (const el of root.querySelectorAll<HTMLElement>('[data-error-for]')) el.textContent = '';
			summaryEl.hidden = true;
			summaryEl.innerHTML = '';
		};

		const showIssues = (issues: Issue[], headline: string) => {
			clearIssues();
			const unplaced: Issue[] = [];
			for (const issue of issues) {
				const el = formEl.querySelector<HTMLElement>(`[data-error-for="${issue.path}"]`);
				if (el) el.textContent = issue.message;
				else unplaced.push(issue);
			}
			summaryEl.hidden = false;
			summaryEl.innerHTML =
				`<p>${esc(headline)}</p>` + (unplaced.length ? `<ul>${unplaced.map((i) => `<li>${esc(i.message)}</li>`).join('')}</ul>` : '');
			setMode('write');
			const first = formEl.querySelector<HTMLElement>('[data-error-for]:not(:empty)');
			(first ?? summaryEl).scrollIntoView({ behavior: 'smooth', block: 'center' });
		};

		const mountTurnstile = () => {
			const el = root.querySelector<HTMLElement>('#qf-turnstile');
			if (!el || !siteKey || turnstileId) return;
			if (!window.turnstile) {
				window.setTimeout(mountTurnstile, 200);
				return;
			}
			turnstileId = window.turnstile.render(el, {
				sitekey: siteKey,
				action: 'propose',
				theme: 'auto',
				'expired-callback': () => window.turnstile?.reset(turnstileId),
				'error-callback': () => false,
			});
		};

		const submit = async () => {
			clearIssues();
			const submission = {
				page: draft.page,
				contributor: draft.contributor,
				notes: draft.notes,
				turnstileToken: window.turnstile?.getResponse(turnstileId) ?? '',
			};
			const local = validateSubmission(submission, categories);
			if (local.length) {
				showIssues(local, 'A few fields need attention before sending.');
				return;
			}
			if (!submission.turnstileToken) {
				showIssues([], 'Complete the human check above the send button first.');
				return;
			}
			submitBtn.disabled = true;
			submitBtn.textContent = 'Sending...';
			try {
				const res = await fetch('/api/propose', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify(submission),
				});
				const data = (await res.json().catch(() => ({}))) as { url?: string; author?: string | null; error?: string; issues?: Issue[] };
				if (res.status === 201 && data.url) {
					root.querySelector<HTMLAnchorElement>('#qf-pr-link')!.href = data.url;
					root.querySelector<HTMLElement>('#qf-done-text')!.textContent = data.author
						? `Thanks. The pull request was opened from your GitHub account, @${data.author}. You can follow the review there:`
						: 'Thanks. Your page is now a pull request. You can follow the review there:';
					localStorage.removeItem(DRAFT_KEY);
					setMode('done');
					return;
				}
				showIssues(data.issues ?? [], data.error ?? 'Something went wrong. Try again in a moment.');
				window.turnstile?.reset(turnstileId);
			} catch {
				showIssues([], 'Could not reach the server. Check your connection and try again.');
			} finally {
				submitBtn.disabled = false;
				submitBtn.textContent = 'Send for review';
			}
		};

		const treeBlock = (index: number) => draft.page.blocks[index] as { type: 'tree'; text: string };

		const editTree = (index: number, edit: (roots: TreeNode[]) => void) => {
			const roots = parseTree(treeBlock(index).text);
			if (!roots) return;
			edit(roots);
			treeBlock(index).text = serializeTree(roots);
			save();
			scheduleOutputs();
		};

		const renderPicker = () => {
			const query = pickerSearch.value.trim().toLowerCase();
			const groups = nodeGroups
				.map((g) => ({ label: g.label, types: g.types.filter((t) => t.toLowerCase().includes(query)) }))
				.filter((g) => g.types.length);
			pickerList.innerHTML = groups.length
				? groups
						.map(
							(g) => `<h3>${esc(g.label)}</h3><div class="picker-grid">${g.types
								.map((t) => `<button type="button" data-action="tree-pick" data-type="${esc(t)}"><img src="${icon(t)}" alt="" width="16" height="16"><span>${esc(t)}</span></button>`)
								.join('')}</div>`,
						)
						.join('')
				: `<p class="hint">No node matches "${esc(pickerSearch.value)}".</p>`;
		};

		const openPicker = (block: number, parent: string) => {
			pickerTarget = { block, parent };
			pickerSearch.value = '';
			renderPicker();
			picker.showModal();
			pickerSearch.focus();
		};

		const pickNode = (type: string) => {
			if (!pickerTarget) return;
			const { block, parent } = pickerTarget;
			let added = '';
			editTree(block, (roots) => {
				const siblings = treeSiblings(roots, parent);
				siblings.push({ name: uniqueNodeName(siblings, type), type, script: false, unique: false, note: '', children: [] });
				added = parent ? `${parent}.${siblings.length - 1}` : `${siblings.length - 1}`;
			});
			picker.close();
			pickerTarget = null;
			renderAll();
			const nameInput = formEl.querySelector<HTMLInputElement>(`[data-tree-block="${block}"][data-tree-path="${added}"][data-tree-field="name"]`);
			nameInput?.focus();
			nameInput?.select();
		};

		pickerSearch.addEventListener('input', renderPicker);
		pickerSearch.addEventListener('keydown', (e) => {
			if (e.key !== 'Enter') return;
			e.preventDefault();
			const first = pickerList.querySelector<HTMLElement>('[data-action="tree-pick"]');
			if (first) pickNode(first.dataset.type!);
		});
		picker.addEventListener('click', (e) => {
			if (e.target === picker) picker.close();
		});

		// Cause table rows follow a heading when it is renamed, and the section
		// pickers list the headings as they are now.
		const syncSectionPicks = (oldText: string, newText: string) => {
			for (const block of draft.page.blocks) {
				if (block.type !== 'causes') continue;
				for (const row of block.rows) if (oldText && row.section.trim() === oldText) row.section = newText;
			}
			const headings = headingTexts(draft.page.blocks);
			for (const pick of formEl.querySelectorAll<HTMLSelectElement>('select[data-section-pick]')) {
				const current = String(getPath(draft, pick.dataset.path!) ?? '');
				pick.innerHTML = sectionPick(pick.dataset.path!, current, headings).replace(/^<select[^>]*>|<\/select>$/g, '');
			}
		};

		root.addEventListener('input', (e) => {
			const el = e.target as HTMLInputElement | HTMLTextAreaElement;
			if (el.dataset.treeField) {
				const field = el.dataset.treeField as 'name' | 'note';
				const clean = field === 'name' ? el.value.replace(/[:"\[\]]/g, '') : el.value.replace(/"/g, '');
				if (clean !== el.value) el.value = clean;
				editTree(Number(el.dataset.treeBlock), (roots) => {
					treeNodeAt(roots, el.dataset.treePath!)[field] = clean;
				});
				return;
			}
			const path = el.dataset.path;
			if (!path) return;
			const headingMatch = path.match(/^page\.blocks\.(\d+)\.text$/);
			const renamedHeading = headingMatch && draft.page.blocks[Number(headingMatch[1])]?.type === 'heading' ? String(getPath(draft, path) ?? '') : null;
			setPath(draft, path, el.value);
			if (renamedHeading !== null) syncSectionPicks(renamedHeading.trim(), el.value.trim());
			if (el instanceof HTMLTextAreaElement && el.classList.contains('code')) scheduleHighlight(el);
			const setField = (field: 'label' | 'slug', value: string) => {
				draft.page[field] = value;
				formEl.querySelector<HTMLInputElement>(`[data-path="page.${field}"]`)!.value = value;
			};
			if (path === 'page.title' && !draft.labelTouched) setField('label', labelFromTitle(el.value));
			if ((path === 'page.title' || path === 'page.label') && !draft.slugTouched) setField('slug', slugify(draft.page.label));
			if (path === 'page.slug') draft.slugTouched = true;
			if (path === 'page.label') draft.labelTouched = true;
			if (path === 'page.categoryLabel' && !draft.categoryTouched) {
				draft.page.category = slugify(el.value);
				formEl.querySelector<HTMLInputElement>('[data-path="page.category"]')!.value = draft.page.category;
			}
			if (path === 'page.category') draft.categoryTouched = true;
			if (path === 'page.category' || path === 'page.categoryLabel') {
				formEl.querySelector<HTMLElement>('.slug .prefix')!.textContent = `queuefree.dev/${draft.page.category}/`;
			}
			save();
			scheduleOutputs();
		});

		// Code fields: Tab indents, Shift+Tab outdents, Enter keeps the indent.
		// Escape then Tab moves focus on, so the keyboard is never trapped.
		let tabLeavesField = false;

		const codeIndent = (el: HTMLTextAreaElement): string => {
			const path = el.dataset.path ?? '';
			if (path.includes('.csharp.')) return '    ';
			return el.dataset.lang === 'csharp' ? '    ' : '\t';
		};

		const replaceSelection = (el: HTMLTextAreaElement, text: string, start: number, end: number, selectAfter?: [number, number]) => {
			el.focus();
			el.setSelectionRange(start, end);
			if (!document.execCommand?.('insertText', false, text)) {
				el.setRangeText(text, start, end, 'end');
				el.dispatchEvent(new Event('input', { bubbles: true }));
			}
			if (selectAfter) el.setSelectionRange(selectAfter[0], selectAfter[1]);
		};

		root.addEventListener('keydown', (e) => {
			const el = e.target as HTMLTextAreaElement;
			if (!(el instanceof HTMLTextAreaElement) || !el.classList.contains('code')) return;
			if (e.key === 'Escape') {
				tabLeavesField = true;
				return;
			}
			if (e.key === 'Tab' && tabLeavesField) {
				tabLeavesField = false;
				return;
			}
			tabLeavesField = false;
			const { value, selectionStart: start, selectionEnd: end } = el;
			const indent = codeIndent(el);

			if (e.key === 'Tab') {
				e.preventDefault();
				const lineStart = value.lastIndexOf('\n', start - 1) + 1;
				if (start === end && !e.shiftKey) {
					replaceSelection(el, indent, start, end);
					return;
				}
				const lineEnd = value.indexOf('\n', end - (end > start ? 1 : 0));
				const blockEnd = lineEnd === -1 ? value.length : lineEnd;
				const lines = value.slice(lineStart, blockEnd).split('\n');
				const changed = lines.map((line) => {
					if (!e.shiftKey) return indent + line;
					if (line.startsWith(indent)) return line.slice(indent.length);
					return line.replace(/^(\t| {1,4})/, '');
				});
				const text = changed.join('\n');
				replaceSelection(el, text, lineStart, blockEnd, [lineStart, lineStart + text.length]);
				return;
			}

			if (e.key === 'Enter' && !e.shiftKey && !e.ctrlKey && !e.metaKey) {
				e.preventDefault();
				const lineStart = value.lastIndexOf('\n', start - 1) + 1;
				const line = value.slice(lineStart, start);
				const current = line.match(/^[\t ]*/)![0];
				const opensBlock = indent === '\t' ? /:\s*$/.test(line) : /\{\s*$/.test(line);
				replaceSelection(el, '\n' + current + (opensBlock ? indent : ''), start, end);
			}
		});

		root.addEventListener('change', (e) => {
			const el = e.target as HTMLSelectElement;
			if (!el.matches('[data-pick-category]')) return;
			draft.newCategory = el.value === '__new__';
			draft.page.category = draft.newCategory ? '' : el.value;
			draft.page.categoryLabel = '';
			draft.categoryTouched = false;
			save();
			renderAll();
			if (draft.newCategory) formEl.querySelector<HTMLInputElement>('[data-path="page.categoryLabel"]')?.focus();
		});

		root.addEventListener('click', (e) => {
			const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-action]');
			if (!btn) return;
			const { action, index, type, dir, item, mode, value, treePath, field: flag, parent, lang, line, mark } = btn.dataset;
			const i = Number(index);
			const blocks = draft.page.blocks;
			const codeBlockEditor = () => formEl.querySelector<HTMLTextAreaElement>(`[data-path="page.blocks.${i}.code"]`);
			switch (action) {
				case 'set-lang': {
					const block = blocks[i] as { lang: string };
					block.lang = lang!;
					for (const b of btn.parentElement!.children) b.setAttribute('aria-checked', String(b === btn));
					const code = codeBlockEditor();
					if (code) {
						code.dataset.lang = lang!;
						highlightField(code);
					}
					save();
					scheduleOutputs();
					return;
				}
				case 'mark-line': {
					const block = blocks[i] as { wrong: string; right: string };
					const n = Number(line);
					const key = mark as 'wrong' | 'right';
					const other = key === 'wrong' ? 'right' : 'wrong';
					const set = lineSet(block[key]);
					const otherSet = lineSet(block[other]);
					set.has(n) ? set.delete(n) : set.add(n);
					otherSet.delete(n);
					block[key] = lineSpec(set);
					block[other] = lineSpec(otherSet);
					const code = codeBlockEditor();
					if (code) {
						code.dataset.wrong = block.wrong;
						code.dataset.right = block.right;
						highlightField(code);
					}
					save();
					scheduleOutputs();
					return;
				}
				case 'github-logout':
					fetch('/api/github/logout', { method: 'POST' })
						.catch(() => {})
						.finally(() => {
							githubUser = null;
							renderAll();
						});
					return;
				case 'preview-tab': {
					previewLang = btn.dataset.lang as 'gdscript' | 'csharp';
					for (const group of previewEl.querySelectorAll<HTMLElement>('.qf-tabs')) {
						for (const t of group.querySelectorAll<HTMLElement>('[role="tab"]')) t.setAttribute('aria-selected', String(t.dataset.lang === previewLang));
						for (const panel of group.querySelectorAll<HTMLElement>('[data-tab-panel]')) panel.hidden = panel.dataset.tabPanel !== previewLang;
					}
					return;
				}
				case 'tree-add':
					openPicker(i, parent ?? '');
					return;
				case 'tree-pick':
					pickNode(type!);
					return;
				case 'tree-cancel':
					picker.close();
					return;
				case 'tree-toggle':
					editTree(i, (roots) => {
						const node = treeNodeAt(roots, treePath!);
						node[flag as 'script' | 'unique'] = !node[flag as 'script' | 'unique'];
					});
					btn.setAttribute('aria-pressed', String(btn.getAttribute('aria-pressed') !== 'true'));
					return;
				case 'tree-remove':
					editTree(i, (roots) => {
						const indexes = treePath!.split('.').map(Number);
						const last = indexes.pop()!;
						treeSiblings(roots, indexes.join('.')).splice(last, 1);
					});
					break;
				case 'tree-move':
					editTree(i, (roots) => {
						const indexes = treePath!.split('.').map(Number);
						const from = indexes.pop()!;
						const to = from + Number(dir);
						const siblings = treeSiblings(roots, indexes.join('.'));
						if (to < 0 || to >= siblings.length) return;
						[siblings[from], siblings[to]] = [siblings[to]!, siblings[from]!];
					});
					break;
				case 'tree-text':
					treeTextMode.add(i);
					break;
				case 'tree-visual':
					treeTextMode.delete(i);
					break;
				case 'set-mode':
					setMode(mode as Mode);
					return;
				case 'set-kind': {
					const kind = ((btn as HTMLInputElement).value || value) as PageKind;
					if (kind === draft.page.kind) return;
					// An untouched template is swapped for the other one; edited content is kept.
					const untouched = JSON.stringify(blocks) === JSON.stringify(templateBlocks(draft.page.kind));
					draft.page.kind = kind;
					if (untouched) draft.page.blocks = templateBlocks(kind);
					if (kind === 'error' && 'errors' in categories) {
						draft.page.category = 'errors';
						draft.newCategory = false;
					}
					break;
				}
				case 'add-block':
					blocks.push(newBlock(type as BlockType));
					break;
				case 'remove-block':
					blocks.splice(i, 1);
					break;
				case 'move-block': {
					const j = i + Number(dir);
					if (j < 0 || j >= blocks.length) return;
					[blocks[i], blocks[j]] = [blocks[j]!, blocks[i]!];
					break;
				}
				case 'add-step':
					(blocks[i] as { items: string[] }).items.push('');
					break;
				case 'remove-step':
					(blocks[i] as { items: string[] }).items.splice(Number(item), 1);
					break;
				case 'add-cause':
					(blocks[i] as { rows: { symptom: string; section: string }[] }).rows.push({ symptom: '', section: '' });
					break;
				case 'remove-cause':
					(blocks[i] as { rows: { symptom: string; section: string }[] }).rows.splice(Number(item), 1);
					break;
				case 'copy-source':
					navigator.clipboard?.writeText(sourceEl.textContent ?? '');
					return;
				case 'reset':
					if (root.querySelector<HTMLElement>('[data-panel="done"]')!.hidden && !confirm('Clear everything and start over?')) return;
					draft = newDraft(categories);
					localStorage.removeItem(DRAFT_KEY);
					renderAll();
					setMode('write');
					return;
				case 'submit':
					submit();
					return;
				default:
					return;
			}
			save();
			renderAll();
			if (action === 'add-block') {
				const added = formEl.querySelector<HTMLElement>(`[data-block="${blocks.length - 1}"]`);
				added?.scrollIntoView({ behavior: 'smooth', block: 'center' });
				added?.querySelector<HTMLElement>('input, textarea')?.focus();
			}
		});

		renderAll();
		mountTurnstile();
	}

	const boot = () => {
		const root = document.getElementById('qf-contribute');
		if (root) init(root);
	};
	boot();
	document.addEventListener('astro:page-load', boot);
</script>

