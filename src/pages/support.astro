---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { KOFI_URL } from '../site.ts';
---

<StarlightPage
	hasSidebar={false}
	frontmatter={{
		title: 'Support this initiative',
		description: 'Queue Free is free and has no ads. If it saved you time, a small donation or a new page helps.',
		tableOfContents: false,
		pagefind: false,
		lastUpdated: false,
	}}
>
	<div class="qf-support not-content">
		<p>Queue Free is free to read, has no ads, and stays that way.</p>
		<p>
			If an answer here saved you an evening, a small donation pays for hosting and buys time to write the next
			page.
		</p>
		<p>
			You can also support in a different way: <a href="/write/">write a page</a> for a question you have seen
			asked too many times.
		</p>
		<a class="kofi" href={KOFI_URL} target="_blank" rel="noopener">
			<img src="/ko-fi_heart.gif" alt="" width="48" height="48" />
			Support me on Ko-Fi
		</a>
	</div>
</StarlightPage>

<style is:global>
	html:root:has(.qf-support) {
		--sl-content-width: 35rem;
	}
	:root:has(.qf-support) .content-panel {
		padding-top: 5rem;
		padding-bottom: 0;
	}
	:root:has(.qf-support) .content-panel + .content-panel {
		padding-top: 1.5rem;
		border-top: 0;
	}
	:root:has(.qf-support) .content-panel h1 {
		margin-top: 0;
		font-size: 2rem;
		line-height: 1.5rem;
	}
	.qf-support {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.qf-support p {
		margin: 0;
	}
	.qf-support .kofi {
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		align-self: flex-start;
		margin-top: 1.5rem;
		padding: 0.5rem 2rem 0.5rem 1rem;
		border-radius: 46px;
		background: var(--qf-accent);
		color: #fff;
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.5rem;
		text-decoration: none;
	}
	.qf-support .kofi img {
		width: 3rem;
		height: 3rem;
	}
	.qf-support .kofi:hover,
	.qf-support .kofi:focus-visible {
		background: linear-gradient(to right, #bf8547, #a8338d);
	}
	.qf-support .kofi:active {
		background: linear-gradient(to right, #bf6b47, #7533a8);
	}
	.qf-support p a {
		color: inherit;
		text-decoration: underline;
	}
</style>
