---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { KOFI_NAME, KOFI_URL } from '../site.ts';
---

<StarlightPage
	hasSidebar={false}
	frontmatter={{
		title: 'Support Queue Free',
		description: 'Queue Free is free and has no ads. If it saved you time, you can buy a coffee.',
		tableOfContents: false,
		pagefind: false,
		lastUpdated: false,
	}}
>
	<div class="qf-support not-content">
		<p>
			Queue Free is free to read, has no ads, and stays that way. Every page is written by hand, tested in a real
			project, and kept up to date as Godot changes.
		</p>
		<p>
			If an answer here saved you an evening, a coffee goes a long way. It pays for hosting and buys time to write
			the next page.
		</p>
		<iframe
			class="kofi-panel"
			src={`https://ko-fi.com/${KOFI_NAME}/?hidefeed=true&widget=true&embed=true&preview=true`}
			height="560"
			title="Support Queue Free on Ko-fi"
			loading="lazy"
		></iframe>
		<p class="hint">
			Ko-fi handles the payment. Queue Free never sees your card details. If the panel does not load,
			<a href={KOFI_URL} target="_blank" rel="noopener">open Ko-fi directly</a>.
		</p>
		<p class="alt">
			Prefer to help another way? <a href="/write/">Write a page</a> for a question you have seen asked too many
			times.
		</p>
	</div>
</StarlightPage>

<style is:global>
	html:root:has(.qf-support) {
		--sl-content-width: 40rem;
	}
	.qf-support {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}
	.qf-support p {
		margin: 0;
	}
	.qf-support .kofi-panel {
		width: 100%;
		border: 1px solid var(--qf-line);
		border-radius: 0.75rem;
		background: #f9f9f9;
	}
	.qf-support .hint {
		color: var(--qf-muted);
		font-size: var(--sl-text-sm);
	}
	.qf-support .alt {
		padding-top: 1rem;
		border-top: 1px solid var(--qf-line);
	}
	.qf-support .hint a,
	.qf-support .alt a {
		color: var(--qf-link);
	}
</style>
