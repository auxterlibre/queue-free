---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { KOFI_URL } from '../site.ts';
---

<StarlightPage
	hasSidebar={false}
	frontmatter={{
		title: 'Support Queue Free',
		description: 'Queue Free is free and has no ads. If it saved you time, you can buy a coffee.',
		tableOfContents: false,
		pagefind: false,
		lastUpdated: false,
	}}
>
	<div class="qf-support not-content">
		<p>
			Queue Free is free to read, has no ads, and stays that way. Every page is written by hand, tested in a real
			project, and kept up to date as Godot changes.
		</p>
		<p>
			If an answer here saved you an evening, a coffee goes a long way. It pays for hosting and buys time to write
			the next page.
		</p>
		<a class="kofi" href={KOFI_URL} target="_blank" rel="noopener">
			<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor">
				<path d="M18 7h1a4 4 0 0 1 0 8h-1.1A6 6 0 0 1 12 20H8a6 6 0 0 1-6-6V7a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1zm0 2v4h1a2 2 0 1 0 0-4h-1zM4 8v6a4 4 0 0 0 4 4h4a4 4 0 0 0 4-4V8H4z" />
			</svg>
			Buy me a coffee on Ko-fi
		</a>
		<p class="hint">Ko-fi handles the payment. Queue Free never sees your card details.</p>
		<p class="alt">
			Prefer to help another way? <a href="/write/">Write a page</a> for a question you have seen asked too many
			times.
		</p>
	</div>
</StarlightPage>

<style is:global>
	html:root:has(.qf-support) {
		--sl-content-width: 40rem;
	}
	.qf-support {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}
	.qf-support p {
		margin: 0;
	}
	.qf-support .kofi {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		align-self: flex-start;
		padding: 0.8rem 1.5rem;
		border-radius: 999px;
		background: var(--qf-accent);
		color: #fff;
		font-weight: 600;
		text-decoration: none;
	}
	.qf-support .kofi:hover,
	.qf-support .kofi:focus-visible {
		filter: brightness(1.1);
	}
	.qf-support .hint {
		color: var(--qf-muted);
		font-size: var(--sl-text-sm);
	}
	.qf-support .alt {
		padding-top: 1rem;
		border-top: 1px solid var(--qf-line);
	}
	.qf-support .alt a {
		color: var(--qf-link);
	}
</style>
